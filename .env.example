# Copy this file to .env (docker compose loads it automatically) to
# configure this host. .env is host-specific and gitignored - each
# machine sets it independently.

# GPU acceleration (see README.md "GPU acceleration"):
# - CPU-only (default, works everywhere): leave commented out.
# - GPU-accelerated (requires nvidia-container-toolkit on this host):
#   uncomment the line below.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml
