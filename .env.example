# Copy this file to .env (docker compose loads it automatically) to
# configure this host. .env is host-specific and gitignored - each
# machine sets it independently.

# GPU acceleration (see README.md "GPU acceleration"):
# - CPU-only (default, works everywhere): leave commented out.
# - GPU-accelerated (requires nvidia-container-toolkit on this host):
#   uncomment the line below.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml

# Jetson (ZED camera host) SSH bootstrap, see jetson_ssh_setup.sh:
# - VOGUI_PASSWORD (main board) is read from vogui_ros1_ros2_bridge/.env or here.
# - JETSON_PASSWORD is only needed for the first connection, to authorise the keys.
# JETSON_PASSWORD=
# Public key of this host to authorise on the board/Jetson (default ~/.ssh/id_ed25519.pub):
# HOST_SSH_PUBKEY_FILE=/home/you/.ssh/id_ed25519.pub

# renee_perception sync to the Jetson, see jetson_code_sync.sh (service jetson-code-sync,
# runs before ros_terminal/scanning/wrist-calibration; non-fatal; no-op when versions match):
# JETSON_SYNC=0                   # disable the automatic sync
# JETSON_SYNC_DRY_RUN=1           # only print what would change
# JETSON_SYNC_SOURCE=worktree     # also send uncommitted host changes (default: head = last commit)
# JETSON_SYNC_FORCE=1             # overwrite Jetson-edited files / differing files on the first sync (backups kept)
# JETSON_CAMERA_RESTART=0         # never restart the camera service after a sync (it runs via tools/camera_link_ctl.sh, not systemd)
# JETSON_CAMERA_AUTOSTART=0       # do not start the camera service when it is down and the versions already match
# JETSON_CAMERA_HOLDERS='record_data.py|zed_aruco_detect.py|zed_wrapper_node'   # processes that hold the ZED: never (re)start while they run
# JETSON_TARGET_DIR=renee_ws/src/renee_perception   # relative to the Jetson's $HOME
# JETSON_POST_SYNC_CMD=           # optional command run on the Jetson in the target dir (none by default)

# Camera link tunnel (jetson-camera-tunnel service): local port the PC action server connects to
# (link_port in renee_action_servers/config/camera_frames_real.yaml) and the camera service's port on the Jetson.
# JETSON_LINK_PORT=7788
# JETSON_LINK_REMOTE_PORT=7788
